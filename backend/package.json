{
  "name": "@amas/backend",
  "version": "1.0.0",
  "private": true,
  "main": "dist/server.js",
  "type": "module",
  "scripts": {
    "build": "tsc && cp -r src/db/migrations dist/db/",
    "start": "node dist/server.js",
    "dev": "node --loader ts-node/esm src/server.ts",
    "migrate": "node --loader ts-node/esm src/db/migrator.ts",
    "test": "vitest run",
    "test:simulate-sync": "node --loader ts-node/esm test/simulate-sync.ts",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@amas/contracts": "*",
    "@fastify/cors": "^9.0.1",
    "@fastify/jwt": "^8.0.1",
    "@fastify/multipart": "^8.3.0",
    "@fastify/rate-limit": "^9.1.0",
    "argon2": "^0.41.1",
    "dotenv": "^16.4.7",
    "exceljs": "^4.4.0",
    "fastify": "^4.28.1",
    "pg": "^8.13.1",
    "pino": "^9.6.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/pg": "^8.11.10",
    "pino-pretty": "^13.0.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.8.0",
    "vitest": "^3.0.5"
  }
}
